DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://tu-dominio.com

# Cron de alertas SLA
CRON_SECRET=

# API key de la API pública v1 (/api/v1/incidentes, /tiendas, /proveedores),
# que consume Power BI y cualquier otro cliente externo. Se manda en la
# cabecera x-api-key. OBLIGATORIA: sin ella la API v1 rechaza todo con 401.
PBI_API_KEY=

# SMTP para alertas por email (nodemailer) — requiere: npm install nodemailer @types/nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NetDesk Footloose <netdesk@footloose.pe>

# MODO PRUEBA — dejar VACÍA en operación normal.
# Con un valor, TODO correo (escalamientos, alertas de SLA, gestión de cambios)
# se desvía a esa casilla en vez de ir al destinatario real, con el asunto
# marcado [PRUEBA] y las copias descartadas. Sirve para validar el envío en
# producción sin escribirle a los proveedores. Borrar al terminar la prueba.
# Acepta varias direcciones separadas por coma.
SMTP_OVERRIDE_TO=

APP_URL=https://tu-dominio.com
