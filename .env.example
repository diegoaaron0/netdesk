# Contraseña inicial asignada a usuarios nuevos cuando el admin no define una.
# Configúrala en producción; los usuarios deberían cambiarla en su primer login.
DEFAULT_USER_PASSWORD=

# Cron de alertas SLA
CRON_SECRET=

# SMTP para alertas por email (nodemailer) — requiere: npm install nodemailer @types/nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NetDesk Footloose <netdesk@footloose.pe>
APP_URL=https://tu-dominio.com
